// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/common/lib/prisma"
}

generator zod {
  provider = "zod-prisma"
  output   = "../src/common/lib/zod"

  relationModel = true // (default) Create and export both plain and related models.

  modelCase = "PascalCase" // (default) Output models using pascal case (ex. UserModel, PostModel)


  modelSuffix = "Schema" // (default) Suffix to apply to your prisma models when naming Zod schemas

  useDecimalJs = true // represent the prisma Decimal type using Decimal.js (as Prisma does)

  prismaJsonNullability = true 

  dateTimeSchema = "union"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String           @db.VarChar(200)
  email      String           @unique @db.VarChar(100)
  country    String?
  city       String?
  zip        String?
  status     OnboardingStatus @default(BASIC)
  created_at DateTime?        @default(now()) @db.Timestamptz()
  updated_at DateTime?        @updatedAt @db.Timestamptz()

  employees Employee[]
  users     User[]
  contracts Contract[]
}

model Employee {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_no     String    @unique @db.VarChar(20)
  email           String    @unique @db.VarChar(100)
  first_name      String    @db.VarChar(200)
  last_name       String    @db.VarChar(200)
  date_of_birth   DateTime  @db.Timestamp()
  position        String    @db.VarChar(200)
  organization_id String    @db.Uuid
  created_at      DateTime? @default(now()) @db.Timestamptz()
  updated_at      DateTime? @updatedAt @db.Timestamptz()

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contracts    Contract[]
}

model Contract {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  start_date      DateTime       @db.Timestamp()
  end_date        DateTime?      @db.Timestamp()
  contract_type   ContractType
  position        String
  amount          Decimal        @db.Decimal(10, 2)
  file_url        String?        @db.Text
  employee_id     String         @db.Uuid
  organization_id String         @db.Uuid
  status          ContractStatus @default(PENDING_SIGNATURE)
  created_at      DateTime?      @default(now()) @db.Timestamptz()
  updated_at      DateTime?      @updatedAt @db.Timestamptz()

  employee     Employee     @relation(fields: [employee_id], references: [id], onDelete: SetDefault)
  organization Organization @relation(fields: [organization_id], references: [id])
}

enum ContractType {
  PERMANENT
  FIXED_TERM
  TEMPORARY
  INTERNSHIP
}

enum ContractStatus {
  ACTIVE
  TERMINATED
  EXPIRED
  PENDING_SIGNATURE
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id      String?   @unique @db.Uuid
  email           String    @unique @db.VarChar(100)
  password        String    @db.Text
  role            Role      @default(EMPLOYEE)
  organization_id String    @db.Uuid
  created_at      DateTime? @default(now()) @db.Timestamptz()
  updated_at      DateTime? @updatedAt @db.Timestamptz()

  organization Organization @relation(fields: [organization_id], references: [id])
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum OnboardingStatus {
  BASIC
  LOCATION
  COMPLETE
}

model RefreshToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @unique
  token      String   @db.Text
  expires_at DateTime @db.Timestamptz()
}
